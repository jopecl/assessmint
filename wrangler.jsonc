// Cloudflare Workers static assets: `node build.mjs` writes public/, `npx wrangler deploy` uploads it
{
  "name": "assessmint",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  // served only on the custom domain (assessmint.app)
  "workers_dev": false,
  "preview_urls": false
}
